namespace DayFiveTraining
{
    class Stack<T>
    {
        List<T> list = new List<T>();
        public void Push(T value)
        {
            list.Add(value);
        }        
        public void Pop()
        {
            Console.WriteLine(list[list.Count - 1]);
            list.RemoveAt(list.Count - 1);
        }
        public void Peek()
        {
            Console.WriteLine(list[list.Count - 1]);
        }
    }
    class StudentManagement
    {
        public static void Student()
        {
            Stack<int> rollNo = new Stack<int>();
            rollNo.Push(121);
            rollNo.Push(122);
            rollNo.Push(123);
            rollNo.Push(124);
            rollNo.Pop();
            rollNo.Peek();

            Stack<String> name = new Stack<string>();
            name.Push("Hussain");
            name.Push("Ibu");
            name.Push("Magesh");
            name.Push("Musthaa");
            name.Pop();
            name.Peek();
        }
    }
}

