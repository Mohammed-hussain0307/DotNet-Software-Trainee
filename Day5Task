using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace DayFiveTraining.ILoggerMechanism
{
    class InjectDependancy
    {
        //create object reference to ilogging interface
        private readonly ILogging logging;

        //assign the object through constructor
        public InjectDependancy(ILogging logging)
        {
            this.logging = logging;
        }

        public void Run()
        {
            logging.LogInfo("Application started.");
            logging.LogWarning("This is a warning message.");
            logging.LogError("An error occurred in the application.");
        }
    }

    class LoggerApplication
    {
        public static void Application()
        {
            //assigned null values to ilogging reference
            ILogging logging = null;

            Console.WriteLine("Choose one option: \n1:ConsoleLogger\n2:FileLogger");
            int choice = Convert.ToInt32(Console.ReadLine());

            //assign the object to the logging for acheive loose coupling
            if (choice == 1)
            {
                logging = new ConsoleLogger();
            }
            else if(choice == 2)
            {
                logging = new FileLogger();
            }
            else
            {
                Console.WriteLine("Invalid! enter only 1 or 2");
            }

            InjectDependancy injectDependancy = new InjectDependancy(logging);
            injectDependancy.Run();
        }
    }
}

