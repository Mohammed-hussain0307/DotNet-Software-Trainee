namespace DayFiveTraining
{
    class Product
    {
        public string PropertiesName { get; set; }
        public string Category { get; set; }
        public double Price { get; set; }

        //for display the result
        public override string ToString()
        {
            return "PropertyName= "+PropertiesName+" Category= "+Category+" Price= "+Price;
        }
    }
    class LinqPractice
    {
        public static void Prod()
        {
            List<Product> list = new List<Product>(){
                new Product { PropertiesName = "Laptop", Category = "Electronics", Price = 1000.00 },
                new Product { PropertiesName = "Phone", Category = "Electronics", Price = 500.00 },
                new Product { PropertiesName = "Shirt", Category = "Clothing", Price = 30.00 },
                new Product { PropertiesName = "Jeans", Category = "Clothing", Price = 50.00 },
                new Product { PropertiesName = "Tablet", Category = "Electronics", Price = 300.00 }
            };

            //linq grouping
            var groupProduct = list.GroupBy(g => g.Category);
            foreach(var category in groupProduct)
            {
                Console.WriteLine("Category: " + category.Key);
                foreach(var product in category)
                {
                    Console.WriteLine(product.PropertiesName+" "+product.Price);
                }
            }

            //linq ordering
            var orderProduct = list.OrderBy(o => o.PropertiesName);
            foreach(var order in orderProduct)
            {
                Console.WriteLine(order);
            }

            //linq Projections
            var projection = list.Select(s => s.PropertiesName +" "+ s.Price);
            foreach(var product in projection)
            {
                Console.WriteLine(product);
            }

            //find the specific category using linq
            var specificCategory = list.Where(c => c.Category.Equals("Clothing"));
            foreach(var categor in specificCategory)
            {
                Console.WriteLine(categor);
            }

            //find the average price
            var averagePrice = list.Average(a => a.Price);
            Console.WriteLine(averagePrice);
        }
    }
}
